<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    STAFF ATTENDEE MANAGEMENT SCREEN (StaffAttendeeManagement.fxml)
    
    This FXML file defines the user interface for the Staff Attendee Management screen in the
    Eventra application. Think of it like a "guest services desk" or "attendee support center"
    where staff members can help manage event participants, handle registrations, and provide
    attendee support.
    
    WHAT THIS SCREEN DOES:
    - Provides staff members with tools to manage event attendees
    - Enables attendee registration management and oversight
    - Offers check-in and attendance tracking capabilities
    - Provides attendee support and assistance tools
    - Shows attendee information and registration status
    - Manages attendee-related workflows and operations
    - Supports event staff in delivering excellent attendee experiences
    
    KEY CONCEPTS TO UNDERSTAND:
    - Attendee Management: Overseeing and supporting event participants
    - Staff Operations: Tools and workflows for event staff members
    - Registration Management: Handling attendee sign-ups and changes
    - Check-in Services: Managing event attendance and participation
    - Attendee Support: Providing assistance and resolving issues
    - User Experience: Intuitive interface for staff attendee management
    
    BUSINESS VALUE:
    - Enables staff to efficiently manage event attendees and provide excellent service
    - Supports smooth event operations through effective attendee management
    - Improves attendee satisfaction through better support and assistance
    - Creates organized event experiences with proper registration and check-in
    - Supports event success through professional attendee management
    - Facilitates better communication between staff and attendees
    
    REAL-WORLD ANALOGY:
    - Like a guest services desk at a hotel or event venue
    - Like a registration table at a conference or workshop
    - Like a customer service center for event participants
    - Like a support desk that helps attendees with their needs
    - Like a concierge service that manages guest experiences
-->

<!-- 
    IMPORT STATEMENTS - JavaFX UI Components
    These statements tell JavaFX which UI components we want to use
    in our attendee management screen. Think of them like importing tools from
    a toolbox that we'll use to build our attendee support interface.
    
    COMPONENTS EXPLAINED:
    - Button: Interactive buttons for attendee management actions and navigation
    - TextField: Text input fields for attendee search and information entry
    - HBox/VBox: Layout containers that organize content horizontally and vertically
    - Text: Text elements for headings, labels, content, and information display
    - Insets: Utilities for adding spacing and padding between elements
-->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!-- 
    MAIN CONTAINER - Vertical Box Layout Structure
    This VBox is the main container that organizes all the attendee management
    content vertically. Think of it like organizing a guest services interface
    with clear sections for different types of attendee management tasks.
    
    LAYOUT EXPLANATION:
    - VBox arranges all content vertically (top to bottom)
    - alignment="CENTER" centers content horizontally
    - spacing="20" adds 20 pixels between major sections
    - styleClass="dashboard-container" applies dashboard-specific styling
    
    PROPERTIES EXPLAINED:
    - xmlns: Standard XML namespace declaration for JavaFX
    - xmlns:fx: JavaFX-specific namespace for special attributes
    - fx:controller: Links this FXML to the StaffAttendeeManagementController Java class
    - stylesheets: Links to the CSS file for visual styling
    - styleClass="dashboard-container": Applies dashboard-specific styling
    
    USER EXPERIENCE:
    - Clean, organized vertical layout
    - Centered content for visual balance
    - Consistent spacing between sections
    - Professional, service-focused appearance
    - Easy to navigate and use
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eventra.controller.StaffAttendeeManagementController"
      alignment="CENTER" spacing="20"
      stylesheets="@../css/styles.css"
      styleClass="dashboard-container">

    <!-- 
        HEADER SECTION - Page title and staff identification
        This section displays the main title and identifies this as the
        staff dashboard for attendee management. Think of it like the
        header of a service desk that clearly states what you're working
        on and who you are.
        
        LAYOUT EXPLANATION:
        - VBox arranges header content vertically
        - alignment="CENTER" centers content horizontally
        - spacing="10" adds 10 pixels between header elements
        - styleClass="dashboard-header" applies header-specific styling
        
        USER EXPERIENCE:
        - Clear page identification and purpose
        - Professional appearance
        - Consistent with other interface elements
        - Easy to understand functionality
    -->
    <VBox alignment="CENTER" spacing="10" styleClass="dashboard-header">
        <!-- 
            MAIN TITLE - "Attendee Management" Text
            This text clearly identifies that this is the attendee management
            page. Think of it like a page heading that tells you exactly
            what you're working on.
            
            PROPERTIES EXPLAINED:
            - fx:id="titleText": Unique identifier for the controller
            - text="Attendee Management": The main title text that displays
            - styleClass="dashboard-title": Applies main title styling
            
            USER EXPERIENCE:
            - Clear page identification
            - Professional appearance
            - Consistent with application design
            - Easy to understand purpose
        -->
        <Text fx:id="titleText" text="Attendee Management" styleClass="dashboard-title"/>
        <!-- 
            SUBTITLE - "Staff Dashboard" Text
            This text identifies that this is specifically for staff members
            and provides context about the user role. Think of it like a
            subtitle that clarifies who this interface is designed for.
            
            PROPERTIES EXPLAINED:
            - text="Staff Dashboard": The subtitle text that displays
            - styleClass="dashboard-subtitle": Applies subtitle styling
            
            USER EXPERIENCE:
            - Clear user role identification
            - Professional appearance
            - Consistent with other interface elements
            - Easy to understand access level
        -->
        <Text text="Staff Dashboard" styleClass="dashboard-subtitle"/>
    </VBox>

    <!-- 
        MAIN CONTENT SECTION - Attendee management information and tools
        This section contains the main content of the attendee management page,
        including information about available features and action buttons.
        Think of it like the main body of a service manual that contains
        the key information and tools you need.
        
        LAYOUT EXPLANATION:
        - VBox arranges content vertically
        - alignment="CENTER" centers content horizontally
        - spacing="15" adds 15 pixels between content elements
        - styleClass="dashboard-content" applies content-specific styling
        
        USER EXPERIENCE:
        - Clear information organization
        - Professional appearance
        - Easy-to-read content layout
        - Consistent with interface design
    -->
    <VBox alignment="CENTER" spacing="15" styleClass="dashboard-content">
        
        <!-- 
            SECTION TITLE - "Attendee Management System" Text
            This text introduces the attendee management system section and
            provides context about what this area offers. Think of it like
            a section header that introduces the main topic.
            
            PROPERTIES EXPLAINED:
            - text="Attendee Management System": The section title text
            - styleClass="dashboard-text": Applies dashboard text styling
            
            USER EXPERIENCE:
            - Clear section identification
            - Professional appearance
            - Consistent with other text elements
            - Easy to understand purpose
        -->
        <Text text="Attendee Management System" styleClass="dashboard-text"/>
        
        <!-- 
            FEATURES INFORMATION - Available attendee management capabilities
            This section describes what attendee management features are available
            to staff members. Think of it like an overview section that
            tells you what tools and capabilities you have access to.
            
            LAYOUT EXPLANATION:
            - VBox arranges feature information vertically
            - spacing="10" adds 10 pixels between information elements
            - styleClass="user-info" applies information section styling
            
            USER EXPERIENCE:
            - Clear feature overview
            - Professional appearance
            - Easy-to-read information layout
            - Consistent with interface design
        -->
        <VBox spacing="10" styleClass="user-info">
            <!-- 
                FEATURE TITLE - "This is the Attendee Management page for Staff" Text
                This text clearly identifies what this page is for and who
                it's designed for. Think of it like an introduction that
                tells you exactly what you're looking at.
                
                PROPERTIES EXPLAINED:
                - text="This is the Attendee Management page for Staff": Description text
                - styleClass="info-title": Applies information title styling
                
                USER EXPERIENCE:
                - Clear page purpose identification
                - Professional appearance
                - Consistent with other interface elements
                - Easy to understand functionality
            -->
            <Text text="This is the Attendee Management page for Staff" styleClass="info-title"/>
            <!-- 
                FEATURE DESCRIPTION - "Here you can manage event attendees" Text
                This text explains what staff members can do on this page.
                Think of it like a description that tells you the main
                capabilities available.
                
                PROPERTIES EXPLAINED:
                - text="Here you can manage event attendees": Description text
                - styleClass="info-text": Applies information text styling
                
                USER EXPERIENCE:
                - Clear capability explanation
                - Professional appearance
                - Consistent with other text elements
                - Easy to understand functionality
            -->
            <Text text="Here you can manage event attendees" styleClass="info-text"/>
            <!-- 
                FEATURE LIST - "Features: Registration, Check-in, and Attendee Support" Text
                This text lists the specific types of attendee management
                features available. Think of it like a feature list that
                shows you exactly what tools you have access to.
                
                PROPERTIES EXPLAINED:
                - text="Features: Registration, Check-in, and Attendee Support": Feature list text
                - styleClass="info-text": Applies information text styling
                
                USER EXPERIENCE:
                - Clear feature listing
                - Professional appearance
                - Consistent with other text elements
                - Easy to understand available tools
            -->
            <Text text="Features: Registration, Check-in, and Attendee Support" styleClass="info-text"/>
        </VBox>

        <!-- 
            ACTION BUTTONS SECTION - Attendee management and navigation
            This section contains buttons that allow staff members to
            manage attendees and navigate back to the main dashboard.
            Think of it like a control panel that gives you access to
            the main functions and navigation options.
            
            LAYOUT EXPLANATION:
            - HBox arranges action buttons horizontally
            - alignment="CENTER" centers buttons horizontally
            - spacing="15" adds 15 pixels between buttons
            - styleClass applies button-specific styling
            
            USER EXPERIENCE:
            - Clear action options
            - Organized button layout
            - Professional appearance
            - Easy task completion
        -->
        <HBox alignment="CENTER" spacing="15">
            <!-- 
                VIEW ATTENDEES BUTTON - Access attendee information
                This button allows staff members to view and manage
                attendee information. Think of it like a "view" button
                that opens up the attendee database or list.
                
                PROPERTIES EXPLAINED:
                - text="View Attendees": Button text that clearly indicates the action
                - onAction="#handleViewAttendees": Calls controller method when clicked
                - styleClass="primary-button": Applies primary button styling
                
                USER EXPERIENCE:
                - Clear indication of what the button does
                - Easy access to attendee information
                - Professional appearance
                - Consistent with application design
            -->
            <Button text="View Attendees"
                    onAction="#handleViewAttendees"
                    styleClass="primary-button"/>
            
            <!-- 
                BACK TO DASHBOARD BUTTON - Return to main dashboard
                This button takes staff members back to the main dashboard
                where they can access other staff functions. Think of it
                like a "return" button that takes you back to the main
                staff area.
                
                PROPERTIES EXPLAINED:
                - text="Back to Dashboard": Button text that clearly indicates the action
                - onAction="#handleBackToDashboard": Calls controller method when clicked
                - styleClass="secondary-button": Applies secondary button styling
                
                USER EXPERIENCE:
                - Clear indication of where the button takes you
                - Easy return to main dashboard
                - Professional appearance
                - Consistent with application design
            -->
            <Button text="Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    styleClass="secondary-button"/>
        </HBox>
    </VBox>

</VBox> 